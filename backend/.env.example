# Copy this file to backend/.env and adjust for your environment.

DJANGO_SECRET_KEY=dev-insecure-key-change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_BASE_URL=http://localhost:3000

# Payment gateway (Aqaye Pardakht sandbox). Use "sandbox" for the PIN in dev.
PAYMENT_GATEWAY_PIN=sandbox
# "sandbox" = real gateway sandbox over HTTP; "simulate" = offline dev stub.
PAYMENT_GATEWAY_MODE=sandbox
PAYMENT_CALLBACK_URL=http://127.0.0.1:8000/api/payments/callback/
