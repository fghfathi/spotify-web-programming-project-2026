# Copy this file to `.env` and adjust values for your environment.

# Django secret key — generate a fresh one for anything non-local.
DJANGO_SECRET_KEY=dev-insecure-change-me

# Debug mode: True for local development, False in production.
DJANGO_DEBUG=True

# Comma-separated hostnames allowed to serve the app.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins allowed to call the API (the Next.js dev server).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
