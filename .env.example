# Optional overrides for `docker compose up`. Every value below already has a
# working default in docker-compose.yml, so copying this file is not required:
#
#     cp .env.example .env    # only if you want to change something
#
# Compose reads a file named `.env` in this directory automatically.

# --- Database -------------------------------------------------------------
POSTGRES_DB=shpotify
POSTGRES_USER=shpotify
POSTGRES_PASSWORD=shpotify

# --- Backend --------------------------------------------------------------
DJANGO_SECRET_KEY=dev-insecure-key-change-me-in-production

# Load demo users, catalog, listening history, tickets and payouts on boot.
# Set to 0 to start from an empty database.
SEED_DEMO_DATA=1

# "simulate" exercises the checkout flow with no network access.
# "sandbox" calls the real Aqaye Pardakht sandbox.
PAYMENT_GATEWAY_MODE=simulate
PAYMENT_GATEWAY_PIN=sandbox

# --- Reporting (3.7) ------------------------------------------------------
# Artist earnings per stream, applied by the backend only.
ARTIST_REVENUE_PER_STREAM=0.004
# Currency symbol returned with every money figure in a report.
PLATFORM_CURRENCY_SYMBOL=$

# --- Frontend -------------------------------------------------------------
# Baked into the client bundle at build time. Must be the URL the browser uses
# to reach the backend, so it is the published host port — not `http://backend`.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
